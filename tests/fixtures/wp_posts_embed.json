[{"id":6283,"date":"2026-06-18T20:24:20","date_gmt":"2026-06-18T20:24:20","guid":{"rendered":"https:\/\/admin-schweikert.house.gov\/?p=6283"},"modified":"2026-06-18T20:24:34","modified_gmt":"2026-06-18T20:24:34","slug":"schweikert-joins-arizona-delegation-in-submitting-copper-pennies-to-congressional-time-capsule-honoring-americas-250th-birthday","status":"publish","type":"post","link":"https:\/\/schweikert.house.gov\/2026\/06\/18\/schweikert-joins-arizona-delegation-in-submitting-copper-pennies-to-congressional-time-capsule-honoring-americas-250th-birthday\/","title":{"rendered":"Schweikert Joins Arizona Delegation in Submitting Copper Pennies to Congressional Time Capsule Honoring America\u2019s 250th Birthday"},"content":{"rendered":"\n<p><strong>WASHINGTON<\/strong> \u2014 U.S. Rep. David Schweikert, R-Ariz., joined Arizona\u2019s bipartisan congressional delegation in submitting 250 copper pennies for inclusion in the Semiquincentennial Congressional Time Capsule, which will commemorate the 250th anniversary of the United States.<\/p>\n\n\n\n<p>The submission honors Arizona\u2019s history as the Copper State and recognizes copper\u2019s role in building the state\u2019s economy, supporting American infrastructure and powering the nation\u2019s future.<\/p>\n\n\n\n<p>\u201cCopper is part of Arizona\u2019s story and America\u2019s story,\u201d Schweikert said. \u201cThis contribution honors our state\u2019s mining heritage and the generations of Arizonans whose work helped build and power the nation.\u201d<\/p>\n\n\n\n<p>Congress authorized the Semiquincentennial Congressional Time Capsule, and the Architect of the Capitol will preserve it in the United States Capitol until July 4, 2276. Americans celebrating the nation\u2019s 500th birthday will open the capsule and reflect on the people, values and achievements that shaped this era.<\/p>\n\n\n\n<p>Arizona\u2019s submission includes 250 copper pennies, one for each year of American independence. Copper is one of Arizona\u2019s historic Five C\u2019s, along with cattle, cotton, citrus and climate. Copper helped shape Arizona\u2019s economy and remains essential to manufacturing, energy production, infrastructure and national defense.<\/p>\n\n\n\n<p>The pennies represent Arizona\u2019s contribution to America\u2019s growth and honor the workers, families and communities that helped build the state.<\/p>\n\n\n\n<p>Click <a href=\"https:\/\/gosar.house.gov\/uploadedfiles\/time_capsule.pdf\" data-type=\"link\" data-id=\"https:\/\/gosar.house.gov\/uploadedfiles\/time_capsule.pdf\">here<\/a> to read the letter submitted with Arizona\u2019s contribution to the Semiquincentennial Congressional Time Capsule.<\/p>\n\n\n\n<p>###<\/p>\n\n\n<figure class=\"wp-block-post-featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"2560\" height=\"1280\" src=\"https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-scaled.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" style=\"object-fit:cover;\" srcset=\"https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-scaled.jpg 2560w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-300x150.jpg 300w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-1024x512.jpg 1024w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-768x384.jpg 768w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-1536x768.jpg 1536w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/01\/Schweikert-Banner-Navy-Logo-Scenic-AZ-2-2048x1024.jpg 2048w\" sizes=\"auto, (max-width: 2560px) 100vw, 2560px\" \/><\/figure>","protected":false},"excerpt":{"rendered":"<p>WASHINGTON \u2014 U.S. Rep. David Schweikert, R-Ariz., joined Arizona\u2019s bipartisan congressional delegation in submitting 250 copper pennies for inclusion in&#8230;<\/p>\n","protected":false},"author":8,"featured_media":6231,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"inline_featured_image":false,"footnotes":""},"categories":[21,19,46],"tags":[],"class_list":["post-6283","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-congress_in_the_news","category-congress_press_release","category-what-schweikert-is-saying"],"acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6283","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/users\/8"}],"replies":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/comments?post=6283"}],"version-history":[{"count":1,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6283\/revisions"}],"predecessor-version":[{"id":6284,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6283\/revisions\/6284"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/media\/6231"}],"wp:attachment":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/media?parent=6283"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories?post=6283"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/tags?post=6283"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"wp:term":[[{"id":21,"link":"https:\/\/schweikert.house.gov\/category\/congress_in_the_news\/","name":"In The News","slug":"congress_