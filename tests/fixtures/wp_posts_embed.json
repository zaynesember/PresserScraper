15T21:53:48","date_gmt":"2026-06-15T21:53:48","guid":{"rendered":"https:\/\/admin-schweikert.house.gov\/?p=6280"},"modified":"2026-06-15T21:54:15","modified_gmt":"2026-06-15T21:54:15","slug":"schweikert-highlights-arizonas-aerospace-industry-at-airbus-day","status":"publish","type":"post","link":"https:\/\/schweikert.house.gov\/2026\/06\/15\/schweikert-highlights-arizonas-aerospace-industry-at-airbus-day\/","title":{"rendered":"Schweikert Highlights Arizona\u2019s Aerospace Industry at Airbus Day"},"content":{"rendered":"<figure class=\"wp-block-post-featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"768\" height=\"1024\" src=\"https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/imagejpeg_0.jpg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" style=\"object-fit:cover;\" srcset=\"https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/imagejpeg_0.jpg 768w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/imagejpeg_0-225x300.jpg 225w\" sizes=\"auto, (max-width: 768px) 100vw, 768px\" \/><\/figure>\n\n\n<p>Last Friday, Congressman David Schweikert spoke at Airbus Day in Phoenix, where Arizona suppliers and aerospace manufacturers discussed the state\u2019s growing role in America\u2019s aviation industry.<\/p>\n\n\n\n<p>The event, hosted by the Arizona Commerce Authority, focused on Arizona\u2019s aerospace ecosystem, current aircraft program needs and next-generation aviation technology. Arizona continues to stand out as a supplier state, with $420 million in direct procurement last year.<\/p>\n\n\n\n<p>The discussion also highlighted continued aerospace investment in Glendale, where Unical Aviation\u2019s headquarters supports aircraft lifecycle solutions and used serviceable materials. The Glendale site is home to 300 employees and plays a role in strengthening the domestic aviation supply chain.<\/p>\n\n\n\n<p>From advanced manufacturing to aircraft lifecycle support, Arizona companies are helping power the future of flight and keeping high-value aerospace work in the state.<\/p>\n\n\n\n<p><\/p>\n","protected":false},"excerpt":{"rendered":"<p>Last Friday, Congressman David Schweikert spoke at Airbus Day in Phoenix, where Arizona suppliers and aerospace manufacturers discussed the state\u2019s&#8230;<\/p>\n","protected":false},"author":8,"featured_media":6281,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"inline_featured_image":false,"footnotes":""},"categories":[21,46],"tags":[],"class_list":["post-6280","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-congress_in_the_news","category-what-schweikert-is-saying"],"acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6280","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/users\/8"}],"replies":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/comments?post=6280"}],"version-history":[{"count":1,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6280\/revisions"}],"predecessor-version":[{"id":6282,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6280\/revisions\/6282"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/media\/6281"}],"wp:attachment":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/media?parent=6280"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories?post=6280"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/tags?post=6280"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"wp:term":[[{"id":21,"link":"https:\/\/schweikert.house.gov\/category\/congress_in_the_news\/","name":"In The News","slug":"congress_in_the_news","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories\/21","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts?categories=21"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":46,"link":"https:\/\/schweikert.house.gov\/category\/congress_in_the_news\/what-schweikert-is-saying\/","name":"What Schweikert is Saying","slug":"what-schweikert-is-saying","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories\/46","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/taxonomies\/category"}],"up":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories\/21"}],"wp:post_type":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts?categories=46"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}},{"id":6274,"date":"2026-06-10T17:10:20","date_gmt":"2026-06-10T17:10:20","guid":{"rendered":"https:\/\/admin-schweikert.house.gov\/?p=6274"},"modified":"2026-06-10T17:10:30","modified_gmt":"2026-06-10T17:10:30","slug":"schweikert-washingtons-pay-first-chase-later-fraud-model-is-broken","status":"publish","type":"post","link":"https:\/\/schweikert.house.gov\/2026\/06\/10\/schweikert-washingtons-pay-first-chase-later-fraud-model-is-broken\/","title":{"rendered":"Schweikert: Washington\u2019s Pay-First, Chase-Later Fraud Model Is Broken"},"content":{"rendered":"\n<p>WASHINGTON, D.C. \u2014 Congressman David Schweikert spoke on the House floor yesterday during debate over waste, fraud and improper payments, calling on Congress to stop relying on an outdated model that sends taxpayer money out the door first and tries to recover it later.<\/p>\n\n\n\n<p>Watch Schweikert\u2019s full remarks <a href=\"https:\/\/www.youtube.com\/watch?v=T5tcxK_yVOM&amp;t=1s\" data-type=\"link\" data-id=\"https:\/\/www.youtube.com\/watch?v=T5tcxK_yVOM&amp;t=1s\">here.<\/a><\/p>\n\n\n\n<p>\u201cSo many of us all use the term waste and fraud,\u201d Schweikert said. \u201cNow we need to actually add some of the definitions and the mechanics of how we\u2019re going to take it on.\u201d<\/p>\n\n\n\n<p>Schweikert said the current approach leaves taxpayers paying the price. Federal dollars go out, bad actors exploit the system, and then Washington hires auditors, lawyers and law enforcement to chase the money after it is already gone.<\/p>\n\n\n\n<p>\u201cI would argue the model we use today is perverse,\u201d he said. \u201cPay someone and then let\u2019s hire lots of auditors, lots of lawyers, lots of law enforcement. Let\u2019s chase it down. How often does someone ever go to prison? How often do we ever get any of the money back?\u201d<\/p>\n\n\n\n<p>Schweikert pointed to modern technology as the way to change that model. Instead of paying first and investigating later, he said Congress should build systems capable of stopping fraudulent payments before they leave Treasury.<\/p>\n\n\n\n<p>\u201cWe have access to technology today so the fraudulent checks never, ever, ever go out the door,\u201d he said. \u201cThis shouldn\u2019t be partisan, but it is technology. We need to take that on.\u201d<\/p>\n\n\n\n<p>He also warned that the same prevention-first approach should apply to overseas scam farms, where criminal organizations force people to target seniors and working families in the United States and across the Western world.<\/p>\n\n\n\n<p>The Joint Economic Committee has sent letters to major telephone companies and internet service providers asking whether they are moving forward with technology that could stop scam-farm calls before they reach Americans.<\/p>\n\n\n\n<p>Schweikert described the operations as deeply immoral, pointing to reports of people being locked inside compounds and forced to steal from others.<\/p>\n\n\n\n<p>\u201cWe have the technology,\u201d Schweikert said, referring to tools that could help stop scam farms from calling \u201cgrandma\u201d and stealing \u201cbillions and billions and billions.\u201d<\/p>\n\n\n\n<p>Last year, Schweikert introduced H.R. 4988, the Scam Farms Marque and Reprisal Authorization Act of 2025. The bill would revive an Article I power Congress already has to issue letters of marque and reprisal. It would allow the president to commission private operators to go after foreign criminal enterprises involved in cybercrime, including scam farms, ransomware, cryptocurrency theft and identity theft.<\/p>\n\n\n\n<p>Schweikert closed by warning that Congress also has to confront waste created by the way some federal programs are designed.<\/p>\n\n\n\n<p>\u201cWhen we say waste and fraud, the waste is often the way we have designed programs,\u201d he said. \u201cWe\u2019re going to have to also take on pieces of legislation that we\u2019ve passed and stop the scammers from scamming us.\u201d<\/p>\n\n\n<figure class=\"wp-block-post-featured-image\"><img loading=\"lazy\" decoding=\"async\" width=\"2561\" height=\"1377\" src=\"https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE-.jpeg\" class=\"attachment-post-thumbnail size-post-thumbnail wp-post-image\" alt=\"\" style=\"object-fit:cover;\" srcset=\"https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE-.jpeg 2561w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE--300x161.jpeg 300w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE--1024x551.jpeg 1024w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE--768x413.jpeg 768w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE--1536x826.jpeg 1536w, https:\/\/schweikert.house.gov\/wp-content\/uploads\/2026\/06\/FORBESDEBATE--2048x1101.jpeg 2048w\" sizes=\"auto, (max-width: 2561px) 100vw, 2561px\" \/><\/figure>","protected":false},"excerpt":{"rendered":"<p>WASHINGTON, D.C. \u2014 Congressman David Schweikert spoke on the House floor yesterday during debate over waste, fraud and improper payments,&#8230;<\/p>\n","protected":false},"author":8,"featured_media":6275,"comment_status":"closed","ping_status":"closed","sticky":false,"template":"","format":"standard","meta":{"_acf_changed":false,"inline_featured_image":false,"footnotes":""},"categories":[21,46],"tags":[],"class_list":["post-6274","post","type-post","status-publish","format-standard","has-post-thumbnail","hentry","category-congress_in_the_news","category-what-schweikert-is-saying"],"acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6274","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/users\/8"}],"replies":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/comments?post=6274"}],"version-history":[{"count":1,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6274\/revisions"}],"predecessor-version":[{"id":6276,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts\/6274\/revisions\/6276"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/media\/6275"}],"wp:attachment":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/media?parent=6274"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories?post=6274"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/tags?post=6274"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]},"_embedded":{"wp:term":[[{"id":21,"link":"https:\/\/schweikert.house.gov\/category\/congress_in_the_news\/","name":"In The News","slug":"congress_in_the_news","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories\/21","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/taxonomies\/category"}],"wp:post_type":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts?categories=21"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":46,"link":"https:\/\/schweikert.house.gov\/category\/congress_in_the_news\/what-schweikert-is-saying\/","name":"What Schweikert is Saying","slug":"what-schweikert-is-saying","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories\/46","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories"}],"about":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/taxonomies\/category"}],"up":[{"embeddable":true,"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/categories\/21"}],"wp:post_type":[{"href":"https:\/\/schweikert.house.gov\/wp-json\/wp\/v2\/posts?categories=46"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}],[]]}}]
